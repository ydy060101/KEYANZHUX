# ---- LLM ----------------------------------------------------------------
# The gateway is the only place that reads these. Business code only passes a tier.
LLM_BASE_URL=http://127.0.0.1:3425/v1
LLM_API_KEY=
LLM_FAST=workbuddy-ai/deepseek-v4.1-flash
LLM_STRONG=workbuddy/deepseek-v4-pro
LLM_VISION_ENABLED=false
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_PER_MIN=60

# ---- Storage ------------------------------------------------------------
# Portable PostgreSQL/Redis are started by scripts/dev.ps1; ports are fixed there.
DATABASE_URL=postgresql+psycopg://research:CHANGE_ME@127.0.0.1:55432/research
REDIS_URL=redis://127.0.0.1:56379/0
DATA_DIR=./data

# ---- Models -------------------------------------------------------------
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
HF_ENDPOINT=https://hf-mirror.com
MODEL_DIR=./.runtime/models

# ---- External APIs ------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
EXTERNAL_TIMEOUT_S=30
EXTERNAL_MAX_RETRIES=3

# ---- Limits -------------------------------------------------------------
UPLOAD_MAX_MB=200
PARSE_MEMORY_LIMIT_MB=4096
LONG_BOOK_WINDOW_PAGES=20
SCANNED_PAGE_CHAR_THRESHOLD=30

# ---- QA -----------------------------------------------------------------
QA_MIN_SCORE=0.35
CHUNK_TARGET_TOKENS=450
RETRIEVAL_RERANK_K=8

# ---- Dedup --------------------------------------------------------------
DEDUP_L3_COSINE=0.95
DEDUP_L3_MINHASH_JACCARD=0.8
